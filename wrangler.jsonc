{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "curiousfish",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "routes": [
    {
      "pattern": "cf.musaraj.com/*",
      "zone_name": "musaraj.com"
    }
  ],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
